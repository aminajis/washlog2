<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <!-- Ikon Kategori Motor Mini -->
        <ImageView
            android:id="@+id/ivRepTxIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_banner_blue"
            android:contentDescription="Kategori Motor"
            android:padding="6dp"
            android:src="@drawable/ic_motor_sedang" />

        <!-- Info Motor, Plat, Washer & Jam -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvRepTxTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Motor Sedang • D 1234 AB"
                android:textColor="@color/deep_slate_navy"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRepTxSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="10:19 WIB • Washer: Fiqri"
                android:textColor="@color/slate_gray"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- Harga & Metode Bayar -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvRepTxPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp 30.000"
                android:textColor="@color/deep_slate_navy"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRepTxPay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Tunai • Struk ›"
                android:textColor="@color/emerald_green"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Garis Pemisah Tipis Antar Baris -->
    <View
        android:id="@+id/dividerRepTx"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="12dp"
        android:background="@color/card_border" />

</LinearLayout>