<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_white"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header: Ikon Gembok + Judul + Tombol Tutup -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_pill_blue"
            android:contentDescription="Ubah PIN"
            android:padding="10dp"
            android:src="@drawable/ic_prof_lock"
            app:tint="@color/royal_blue" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ubah PIN Kasir"
                android:textColor="@color/deep_slate_navy"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Perbarui kode keamanan 4-digit POS Anda"
                android:textColor="@color/slate_gray"
                android:textSize="10.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnCloseChangePin"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_input_field"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/slate_gray"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 1. PIN Saat Ini -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PIN Saat Ini"
            android:textColor="@color/deep_slate_navy"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_delete_red"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="Wajib"
            android:textColor="#DC2626"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <EditText
        android:id="@+id/etOldPin"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_field"
        android:gravity="center"
        android:hint="•  •  •  •"
        android:inputType="numberPassword"
        android:letterSpacing="0.35"
        android:maxLength="4"
        android:paddingHorizontal="12dp"
        android:textColor="@color/deep_slate_navy"
        android:textColorHint="@color/slate_gray"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- 2. PIN Baru (4-Digit) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="PIN Baru (4-Digit)"
        android:textColor="@color/deep_slate_navy"
        android:textSize="11.5sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etNewPin"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_option_selected"
        android:gravity="center"
        android:hint="•  •  •  •"
        android:inputType="numberPassword"
        android:letterSpacing="0.35"
        android:maxLength="4"
        android:paddingHorizontal="12dp"
        android:textColor="@color/royal_blue"
        android:textColorHint="@color/slate_gray"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Gunakan kombinasi angka yang mudah diingat kasir"
        android:textColor="@color/royal_blue"
        android:textSize="10sp" />

    <!-- 3. Konfirmasi PIN Baru -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Konfirmasi PIN Baru"
            android:textColor="@color/deep_slate_navy"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_green"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="✓ Cocok"
            android:textColor="@color/emerald_green"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <EditText
        android:id="@+id/etConfirmPin"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_option_selected"
        android:gravity="center"
        android:hint="•  •  •  •"
        android:inputType="numberPassword"
        android:letterSpacing="0.35"
        android:maxLength="4"
        android:paddingHorizontal="12dp"
        android:textColor="@color/royal_blue"
        android:textColorHint="@color/slate_gray"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Banner Keamanan PIN -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_banner_blue"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="Keamanan"
            android:src="@drawable/ic_info_blue" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="PIN ini digunakan untuk keamanan akses riwayat transaksi &amp; perubahan data pengeluaran."
            android:textColor="@color/deep_slate_navy"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Tombol Simpan PIN Baru -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSaveNewPin"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_btn_navy"
        android:text="✓  Simpan PIN Baru"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>