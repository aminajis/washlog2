<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootReceipt"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:orientation="vertical">

    <!-- TOP BAR -->
    <LinearLayout
        android:id="@+id/topBarReceipt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <TextView
            android:id="@+id/btnBackReceipt"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="←"
            android:textColor="@color/deep_slate_navy"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Struk Transaksi"
            android:textColor="@color/deep_slate_navy"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="Logo WashLog"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_washlog" />
    </LinearLayout>

    <!-- KONTEN SCROLLABLE -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- IKON CENTANG HIJAU BULAT -->
            <FrameLayout
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_pill_green">

                <TextView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_pill_green"
                    android:backgroundTint="#10B981"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Transaksi Berhasil!"
                android:textColor="@color/deep_slate_navy"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center"
                android:text="Data cucian telah tercatat di sistem WashLog"
                android:textColor="@color/slate_gray"
                android:textSize="11.5sp" />

            <!-- KARTU STRUK UTAMA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- Header Biru: WASHLOG • NAMA OUTLET + Badge LUNAS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_banner_blue"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="8dp">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:contentDescription="Outlet"
                        android:src="@drawable/ic_prof_store"
                        app:tint="@color/royal_blue" />

                    <TextView
                        android:id="@+id/tvReceiptHeader"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="WASHLOG • OUTLET"
                        android:textColor="@color/royal_blue"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_green"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="2dp"
                        android:text="LUNAS"
                        android:textColor="@color/emerald_green"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- No. Struk -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="No. Struk"
                        android:textColor="@color/slate_gray"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/tvReceiptNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="#WNL-20261122-001"
                        android:textColor="@color/deep_slate_navy"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Waktu Masuk -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Waktu Masuk"
                        android:textColor="@color/slate_gray"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/tvReceiptTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="22 Nov 2026, 12:36 WIB"
                        android:textColor="@color/deep_slate_navy"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="@color/card_border" />

                <!-- Kategori Kendaraan & Kotak Plat Nomor -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivReceiptMotorIcon"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_banner_blue"
                        android:contentDescription="Motor"
                        android:padding="7dp"
                        android:src="@drawable/ic_motor_kecil" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kategori Kendaraan"
                            android:textColor="@color/slate_gray"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvReceiptMotorName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="Motor Kecil"
                            android:textColor="@color/deep_slate_navy"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvReceiptPlatBox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input_field"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:text="-"
                        android:textColor="@color/deep_slate_navy"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Worker / Pencuci & Metode Pembayaran -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_input_field"
                        android:contentDescription="Worker"
                        android:padding="8dp"
                        android:src="@drawable/ic_prof_user_plus"
                        app:tint="@color/slate_gray" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Worker / Pencuci"
                            android:textColor="@color/slate_gray"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvReceiptWasher"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="Kasir"
                            android:textColor="@color/deep_slate_navy"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvReceiptPayMethod"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input_field"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="4dp"
                        android:text="Tunai"
                        android:textColor="@color/slate_gray"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="@color/card_border" />

                <!-- Total Biaya Cuci -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Total Biaya Cuci"
                        android:textColor="@color/slate_gray"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvReceiptTotalPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rp 15.000"
                        android:textColor="@color/deep_slate_navy"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Strip Info Komisi Worker Otomatis -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_banner_blue"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/tvReceiptCommLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Komisi Worker (40% Otomatis)"
                        android:textColor="@color/slate_gray"
                        android:textSize="10.5sp" />

                    <TextView
                        android:id="@+id/tvReceiptCommAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rp 6.000"
                        android:textColor="@color/royal_blue"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- KARTU KIRIM STRUK KE WHATSAPP -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Kirim Struk ke WA"
                        android:textColor="@color/deep_slate_navy"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gratis &amp; Praktis"
                        android:textColor="@color/emerald_green"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_field"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="6dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="WhatsApp"
                        android:src="@drawable/ic_prof_wa"
                        app:tint="@color/emerald_green" />

                    <EditText
                        android:id="@+id/etTargetPhone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="081234567890"
                        android:inputType="phone"
                        android:singleLine="true"
                        android:textColor="@color/deep_slate_navy"
                        android:textColorHint="@color/slate_gray"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/btnSendReceiptWa"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_btn_navy"
                        android:backgroundTint="#10B981"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="Kirim WA"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- TOMBOL SELESAI & ANTREAN BERIKUTNYA -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDoneReceipt"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_btn_navy"
                android:text="✓  Selesai &amp; Antrean Berikutnya"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <!-- LINK CETAK THERMAL BLUETOOTH -->
            <LinearLayout
                android:id="@+id/btnPrintThermal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingVertical="4dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:contentDescription="Printer"
                    android:src="@drawable/ic_tx_printer"
                    app:tint="@color/slate_gray" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Cetak via Mini Thermal Bluetooth"
                    android:textColor="@color/slate_gray"
                    android:textSize="11.5sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>