<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootProfile"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:orientation="vertical">

    <!-- TOP BAR -->
    <LinearLayout
        android:id="@+id/topBarProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <TextView
            android:id="@+id/btnBackProfile"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="←"
            android:textColor="@color/deep_slate_navy"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Profil"
            android:textColor="@color/deep_slate_navy"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="Logo WashLog"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_washlog" />
    </LinearLayout>

    <!-- KONTEN SCROLLABLE -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="24dp">

            <!-- 1. KARTU PROFIL OUTLET (PERSIS FIGMA) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Baris Atas: Foto Kotak Membulat + Nama Outlet + Badge Outlet Aktif -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/cardProfileAvatar"
                        android:layout_width="58dp"
                        android:layout_height="58dp">

                        <androidx.cardview.widget.CardView
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            app:cardBackgroundColor="#EFF6FF"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <ImageView
                                    android:id="@+id/ivProfileAvatarFallback"
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="Outlet"
                                    android:src="@drawable/ic_prof_store"
                                    app:tint="@color/royal_blue" />

                                <ImageView
                                    android:id="@+id/ivProfileOutletAvatar"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="Foto Outlet"
                                    android:scaleType="centerCrop"
                                    android:visibility="gone" />
                            </FrameLayout>
                        </androidx.cardview.widget.CardView>

                        <!-- Titik Hijau Online di Pojok Kanan Bawah Foto -->
                        <View
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:layout_gravity="bottom|end"
                            android:layout_marginEnd="2dp"
                            android:layout_marginBottom="2dp"
                            android:background="@drawable/bg_pill_green"
                            android:backgroundTint="#10B981" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvProfileOutletName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Outlet WashLog"
                            android:textColor="@color/deep_slate_navy"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_pill_blue"
                            android:paddingHorizontal="9dp"
                            android:paddingVertical="3dp"
                            android:text="✓  Outlet Aktif"
                            android:textColor="@color/royal_blue"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Kotak WhatsApp Pemilik + Tombol Salin -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_input_field"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="11dp">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_pill_green"
                        android:contentDescription="WhatsApp"
                        android:padding="8dp"
                        android:src="@drawable/ic_prof_wa"
                        app:tint="@color/emerald_green" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="WhatsApp Pemilik"
                            android:textColor="@color/slate_gray"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvProfileOwnerPhone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="-"
                            android:textColor="@color/deep_slate_navy"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnCopyOwnerPhone"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_card_white"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp">

                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:contentDescription="Salin"
                            android:src="@drawable/ic_prof_copy"
                            app:tint="@color/royal_blue" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="Salin"
                            android:textColor="@color/royal_blue"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 2 Tombol Aksi Sejajar: Ubah PIN Kasir & Edit Profil Outlet -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/btnOpenChangePin"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_field"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="8dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:contentDescription="PIN"
                            android:src="@drawable/ic_prof_lock"
                            app:tint="@color/royal_blue" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Ubah PIN Kasir"
                            android:textColor="@color/deep_slate_navy"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnOpenEditProfile"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_field"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="8dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:contentDescription="Edit"
                            android:src="@drawable/ic_prof_store"
                            app:tint="@color/deep_slate_navy" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Edit Profil Outlet"
                            android:textColor="@color/deep_slate_navy"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 2. KARTU DAFTAR PEKERJA CUCI -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Daftar Pekerja Cuci"
                    android:textColor="@color/deep_slate_navy"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Aktifkan/nonaktifkan pekerja tanpa menghapus histori laporan."
                    android:textColor="@color/slate_gray"
                    android:textSize="11sp" />

                <!-- Pill Total Pekerja Terdaftar -->
                <TextView
                    android:id="@+id/tvWorkerCountHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_pill_blue"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="Total 0 Pekerja Terdaftar"
                    android:textColor="@color/royal_blue"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/pbProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:visibility="gone" />

                <!-- Empty State Worker -->
                <LinearLayout
                    android:id="@+id/cardEmptyWorkers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_input_field"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Belum ada pekerja terdaftar"
                        android:textColor="@color/deep_slate_navy"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Tekan tombol '+ Tambah Karyawan Baru' di bawah untuk mendaftarkan washer."
                        android:textColor="@color/slate_gray"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Container Daftar Pekerja Live -->
                <LinearLayout
                    android:id="@+id/llWorkerList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />

                <!-- Tombol Hitam/Navy Penuh: + Tambah Karyawan Baru -->
                <LinearLayout
                    android:id="@+id/btnAddWorker"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_btn_navy"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:contentDescription="Tambah Karyawan"
                        android:src="@drawable/ic_prof_user_plus"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="+ Tambah Karyawan Baru"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- 3. KARTU PREFERENSI SISTEM (PENGATURAN KOMISI DEFAULT) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:contentDescription="Preferensi"
                        android:src="@drawable/ic_prof_sliders"
                        app:tint="@color/royal_blue" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Preferensi Sistem"
                        android:textColor="@color/deep_slate_navy"
                        android:textSize="14.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_input_field"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pengaturan Komisi Default"
                        android:textColor="@color/slate_gray"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <!-- Box 1: Pekerja -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_card_white"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pekerja"
                                android:textColor="@color/slate_gray"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tvPrefWorkerPct"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="40%"
                                android:textColor="@color/deep_slate_navy"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Box 2: Operasional -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_card_white"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Operasional"
                                android:textColor="@color/slate_gray"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tvPrefOpsPct"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="40%"
                                android:textColor="@color/deep_slate_navy"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Box 3: Pemilik -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_card_white"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pemilik"
                                android:textColor="@color/slate_gray"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tvPrefOwnerPct"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="20%"
                                android:textColor="@color/royal_blue"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 4. TOMBOL KELUAR (OUTLINE MERAH PERSIS FIGMA) -->
            <LinearLayout
                android:id="@+id/btnLogoutShift"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_logout_red"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Keluar"
                    android:src="@drawable/ic_prof_logout"
                    app:tint="#EF4444" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Keluar"
                    android:textColor="#EF4444"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM NAVIGATION BAR -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/card_border" />

    <LinearLayout
        android:id="@+id/bottomNavProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp">

        <!-- Tab 1: Beranda -->
        <LinearLayout
            android:id="@+id/navHomeProf"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="2dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Beranda"
                android:src="@drawable/ic_nav_beranda"
                app:tint="#475569" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Beranda"
                android:textColor="#475569"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- Tab 2: Pengeluaran -->
        <LinearLayout
            android:id="@+id/navExpenseProf"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="2dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Pengeluaran"
                android:src="@drawable/ic_nav_pengeluaran"
                app:tint="#475569" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Pengeluaran"
                android:textColor="#475569"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- Tab 3: Laporan -->
        <LinearLayout
            android:id="@+id/navReportProf"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="2dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Laporan"
                android:src="@drawable/ic_nav_laporan"
                app:tint="#475569" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Laporan"
                android:textColor="#475569"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- Tab 4: Pengaturan (Aktif) -->
        <LinearLayout
            android:id="@+id/navProfileProf"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="2dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Pengaturan"
                android:src="@drawable/ic_nav_pengaturan"
                app:tint="@color/royal_blue" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Pengaturan"
                android:textColor="@color/royal_blue"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>