<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_white"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Baris Ikon Header + Tombol Tutup -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_pill_blue"
            android:contentDescription="Tambah Pekerja"
            android:padding="10dp"
            android:src="@drawable/ic_prof_user_plus"
            app:tint="@color/royal_blue" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnCloseAddWorker"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_input_field"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/slate_gray"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Judul & Subjudul -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Tambah Pekerja Baru"
        android:textColor="@color/deep_slate_navy"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Daftarkan tenaga cuci motor untuk penugasan antrean kasir."
        android:textColor="@color/slate_gray"
        android:textSize="11.5sp" />

    <!-- 1. Nama Lengkap Pekerja -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Nama Lengkap Pekerja"
            android:textColor="@color/deep_slate_navy"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_blue"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="Wajib diisi"
            android:textColor="@color/royal_blue"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_field"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="Nama"
            android:src="@drawable/ic_prof_user_plus"
            app:tint="@color/slate_gray" />

        <EditText
            android:id="@+id/etWorkerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@null"
            android:hint="Contoh: Agus Pratama"
            android:inputType="textPersonName|textCapWords"
            android:singleLine="true"
            android:textColor="@color/deep_slate_navy"
            android:textColorHint="@color/slate_gray"
            android:textSize="12.5sp" />
    </LinearLayout>

    <!-- 2. Nomor WhatsApp / HP -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Nomor WhatsApp / HP"
            android:textColor="@color/deep_slate_navy"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_field"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="Opsional"
            android:textColor="@color/slate_gray"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_field"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="13dp"
            android:contentDescription="ID"
            android:src="@drawable/ic_flag_id" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="+62"
            android:textColor="@color/deep_slate_navy"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:layout_marginHorizontal="8dp"
            android:background="@color/card_border" />

        <EditText
            android:id="@+id/etWorkerPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:hint="812-3456-7890"
            android:inputType="phone"
            android:singleLine="true"
            android:textColor="@color/deep_slate_navy"
            android:textColorHint="@color/slate_gray"
            android:textSize="12.5sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:contentDescription="WA"
            android:src="@drawable/ic_prof_wa"
            app:tint="@color/emerald_green" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="Untuk pengiriman slip rekap komisi harian via WhatsApp."
            android:textColor="@color/slate_gray"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- 3. Penetapan Shift Awal (3 Kartu dengan Jam Kerja) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Penetapan Shift Awal"
        android:textColor="@color/deep_slate_navy"
        android:textSize="11.5sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chipShiftPagi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_option_selected"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:paddingVertical="8dp"
            android:text="✓ Pagi\n08:00 - 16:00"
            android:textColor="@color/royal_blue"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chipShiftSore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_option_unselected"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:paddingVertical="8dp"
            android:text="Sore\n14:00 - 21:00"
            android:textColor="@color/deep_slate_navy"
            android:textSize="10.5sp" />

        <TextView
            android:id="@+id/chipShiftFull"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_option_unselected"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:paddingVertical="8dp"
            android:text="Fleksibel\nFull-time"
            android:textColor="@color/deep_slate_navy"
            android:textSize="10.5sp" />
    </LinearLayout>

    <!-- Banner Info Biru -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_banner_blue"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="Info"
            android:src="@drawable/ic_info_blue" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Pekerja baru akan langsung muncul di pilihan dropdown Input Transaksi Kasir setelah disimpan."
            android:textColor="@color/deep_slate_navy"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Tombol Simpan Pekerja -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSaveWorkerModal"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_btn_navy"
        android:text="✓  Simpan Pekerja"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>