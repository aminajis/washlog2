<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card_white"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Baris Atas: Ikon Motor, Nama/Plat, Harga & Metode Bayar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivTxIcon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_banner_blue"
            android:contentDescription="Kategori Motor"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_motor_sedang" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTxMotorName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Honda Vario 160"
                    android:textColor="@color/deep_slate_navy"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTxCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_input_field"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="Motor Matic"
                    android:textColor="@color/slate_gray"
                    android:textSize="9sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTxPlatWasher"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Z 1234 AB • Budi"
                android:textColor="@color/slate_gray"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTxPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp 15.000"
                android:textColor="@color/deep_slate_navy"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTxPayMethod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_pill_indigo"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="Tunai"
                android:textColor="@color/royal_blue"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Baris Bawah: Jam & Status Struk WhatsApp -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvTxTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🕒 10:30"
            android:textColor="@color/slate_gray"
            android:textSize="10sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓ WhatsApp Struk"
            android:textColor="@color/emerald_green"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>